---
import { SERVICE_URL } from '../consts';

interface Props {
  articleId: string;
}

const { articleId } = Astro.props;

const UTM_SOURCE = 'magazine';
const UTM_MEDIUM = 'referral';
const UTM_CAMPAIGN = 'article_cta';

const url = new URL(SERVICE_URL);
url.searchParams.set('utm_source', UTM_SOURCE);
url.searchParams.set('utm_medium', UTM_MEDIUM);
url.searchParams.set('utm_campaign', UTM_CAMPAIGN);
url.searchParams.set('utm_content', articleId);
---
<aside class="cta" aria-label="envas のご案内" data-pagefind-ignore>
  <p class="lead">WEB 席次表 &amp; プロフィールブック</p>
  <p class="name">envas</p>
  <p class="body">席次表とプロフィールブックを、ゲストのスマートフォンへ。<br />作成は無料で、気に入ったら購入できます。</p>
  <a class="button" href={url.href}>無料で作成してみる</a>
</aside>

<style>
  .cta {
    margin-top: 80px;
    padding: 48px 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-top: 3px solid var(--color-brand);
  }
  p {
    margin: 0;
  }
  .lead {
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--color-text-sub);
  }
  .name {
    margin-top: 4px;
    font-family: var(--font-en);
    font-size: 36px;
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.3;
  }
  .body {
    margin-top: 20px;
    font-size: 15px;
    line-height: 2;
    color: var(--color-text-prose);
  }
  .button {
    margin-top: 28px;
    padding: 16px 40px;
    border-radius: 999px;
    background: var(--color-link);
    color: var(--color-text-on-link);
    font-size: 15px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .button:hover {
    background: var(--color-link-hover);
  }
  @media (max-width: 760px) {
    .cta {
      padding: 40px 20px;
    }
    .button {
      padding: 16px 24px;
    }
    .body br {
      display: none;
    }
  }
</style>
